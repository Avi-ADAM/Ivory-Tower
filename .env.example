# Postgres connection. Leave unset to use the embedded PGlite database in DATA_DIR.
DATABASE_URL=
# Where the embedded PGlite database lives when DATABASE_URL is unset.
DATA_DIR=./data/pglite

# ── Sign-in through 1lev1 (production, on a *.1lev1.com subdomain) ──
# When STRAPI_URL is set, the shared `jwt` cookie of .1lev1.com is the session
# and the local display-name login is off.
STRAPI_URL=
# The x-strapi-gate secret nginx requires in front of Strapi (same value as 1lev1's STRAPI_GATE_KEY).
STRAPI_GATE_KEY=
# 1lev1 itself, for the rikma bridge (/api/send, /api/action, called as the member).
LEV_URL=https://1lev1.com
# Where to send readers to sign in (1lev1 returns them via ?from=).
LEV_LOGIN_URL=https://1lev1.com/login
# adapter-node needs the public origin behind a proxy, e.g. https://tower.1lev1.com
ORIGIN=
# How often (seconds) a rikma member's visit re-asks 1lev1 where a branch's mission stands. Default 120.
WORK_STATUS_REFRESH_SECONDS=
