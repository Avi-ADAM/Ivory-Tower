{
  "name": "ivory-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ivory Tower (מגדל השן) — a branching argument map for open inquiry",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/pg": "^8.11.0",
    "svelte": "~5.56.10",
    "svelte-check": "^4.6.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
